---
const title = 'Shivam Hospitals | Care, closer to home';
const description = 'A more personal approach to care for patients and families in Ranebennur.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f7f9f7" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero__ambient" aria-hidden="true"></div>
        <div class="hero__copy">
          <p class="hero__location"><span></span> RANEBENNUR, KARNATAKA</p>
          <h1 id="hero-title">Care, closer<br />to <em>home.</em></h1>
          <p class="hero__description">A more personal approach to care for the people and families of Ranebennur.</p>
          <a class="hero__cta" href="https://www.google.com/maps/search/?api=1&query=Shivam+Hospitals+Ranebennur" target="_blank" rel="noreferrer">
            <span>Find the hospital</span>
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M10 5l5 5-5 5" /></svg>
          </a>
          <p class="hero__note">SHIVAM HOSPITALS <b>·</b> PASSION FOR HEALING</p>
        </div>
        <div class="hero__visual" id="hero-visual">
          <div class="hero__wash" aria-hidden="true"></div>
          <img class="hero__fallback" src="/images/hero/layer-03-hospital-photo.webp" alt="Front exterior of Shivam Hospitals in Ranebennur" fetchpriority="high" width="600" height="338" />
          <canvas class="hero__canvas" aria-hidden="true"></canvas>
          <div class="hero__caption" aria-hidden="true"><i></i> SHIVAM HOSPITALS <span>RANEBENNUR · INDIA</span></div>
          <div class="hero__progress" aria-hidden="true"><span></span></div>
        </div>
        <div class="hero__bottom" aria-hidden="true"><span>01 / A PLACE FOR CARE</span><span>SCROLL TO EXPLORE <i></i></span></div>
      </section>
    </main>
    <script>
      const canvas = document.querySelector('.hero__canvas');
      const visual = document.querySelector('.hero__visual');
      const fallback = document.querySelector('.hero__fallback');
      const progress = document.querySelector('.hero__progress span');
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const paths = ['/images/hero/layer-01-outline.svg','/images/hero/layer-02-depth.svg','/images/hero/layer-03-hospital-photo.webp'];
      let images = [], raf = 0, complete = false;

      function shuffled(count) {
        const values = Array.from({length: count}, (_, i) => i);
        let seed = 20261102;
        for (let i = count - 1; i > 0; i--) {
          seed = (seed * 1664525 + 1013904223) >>> 0;
          const j = seed % (i + 1);
          [values[i], values[j]] = [values[j], values[i]];
        }
        return values;
      }

      function surface() {
        const bounds = visual.getBoundingClientRect();
        const ratio = Math.min(devicePixelRatio || 1, 1.35);
        canvas.width = Math.max(1, Math.round(bounds.width * ratio));
        canvas.height = Math.max(1, Math.round(bounds.height * ratio));
        const buffer = document.createElement('canvas');
        buffer.width = canvas.width; buffer.height = canvas.height;
        const ctx = canvas.getContext('2d', {alpha:false});
        const bufferCtx = buffer.getContext('2d', {alpha:false});
        const draw = (image, target) => {
          target.fillStyle = '#f7f9f7';
          target.fillRect(0, 0, canvas.width, canvas.height);
          const scale = Math.max(canvas.width / image.width, canvas.height / image.height);
          const w = image.width * scale, h = image.height * scale;
          target.drawImage(image, (canvas.width-w)/2, (canvas.height-h)/2, w, h);
        };
        return {ctx, buffer, bufferCtx, draw};
      }

      function reveal(from, to, duration, done) {
        const {ctx, buffer, bufferCtx, draw} = surface();
        const w = canvas.width, h = canvas.height, cell = Math.max(8, Math.round(w/112));
        const cols = Math.ceil(w/cell), rows = Math.ceil(h/cell), order = shuffled(cols*rows);
        draw(images[from], ctx); draw(images[to], bufferCtx);
        let shown = 0;
        const perFrame = Math.max(16, Math.ceil(order.length/(duration/16.67)));
        const start = performance.now();
        function tick(now) {
          const p = Math.min(1, (now-start)/duration);
          const count = p === 1 ? order.length : Math.min(order.length, Math.max(Math.floor(p*order.length), shown+perFrame));
          for (let n=shown; n<count; n++) {
            const tile=order[n], x=(tile%cols)*cell, y=Math.floor(tile/cols)*cell;
            const tw=Math.min(cell,w-x), th=Math.min(cell,h-y);
            ctx.drawImage(buffer,x,y,tw,th,x,y,tw,th);
          }
          shown=count; progress.style.width=((to+p)/3*100)+'%';
          if (shown<order.length) raf=requestAnimationFrame(tick); else done?.();
        }
        raf=requestAnimationFrame(tick);
      }

      Promise.all(paths.map(path => new Promise((resolve,reject) => {
        const img=new Image(); img.decoding='async'; img.onload=()=>resolve(img); img.onerror=reject; img.src=path;
      }))).then(loaded => {
        images=loaded;
        const {ctx,draw}=surface();
        draw(reduceMotion ? images[2] : images[0],ctx);
        canvas.classList.add('is-visible'); fallback.classList.add('is-covered');
        if (reduceMotion) { progress.style.width='100%'; complete=true; return; }
        setTimeout(()=>reveal(0,1,1800,()=>setTimeout(()=>reveal(1,2,2000,()=>{
          progress.style.width='100%'; visual.classList.add('is-complete'); complete=true;
        }),380)),380);
      }).catch(()=> {
        canvas.classList.remove('is-visible'); fallback.classList.remove('is-covered');
      });

      const observer = new ResizeObserver(() => {
        if (!complete || images.length !== 3) return;
        const {ctx,draw}=surface(); draw(images[2],ctx);
      });
      observer.observe(visual);
      document.addEventListener('visibilitychange',()=>{ if(document.hidden) cancelAnimationFrame(raf); });
    </script>
  </body>
</html>
<style is:global>
  :root{color-scheme:light;font-family:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-synthesis:none;text-rendering:optimizeLegibility}
  *{box-sizing:border-box}html{background:#f7f9f7;scroll-behavior:smooth}body{margin:0;color:#10253d}
  .hero{position:relative;display:grid;grid-template-columns:minmax(350px,39%) 1fr;height:100svh;min-height:650px;max-height:1040px;overflow:hidden;isolation:isolate;background:#f7f9f7}
  .hero__ambient{position:absolute;inset:0;z-index:-1;background:radial-gradient(ellipse at 76% 46%,rgba(222,235,235,.72),transparent 48%),linear-gradient(115deg,#fbfcfb,#f4f7f6)}
  .hero__copy{position:relative;z-index:2;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding:5vh 0 9vh clamp(28px,7.2vw,116px);max-width:640px}
  .hero__location{display:flex;align-items:center;gap:10px;margin:0 0 30px;color:#587064;font-size:10px;font-weight:700;letter-spacing:.19em}
  .hero__location span{width:7px;height:7px;border-radius:50%;background:#009040;box-shadow:0 0 0 4px #0090401a}
  h1{margin:0;max-width:590px;color:#082849;font-size:clamp(54px,6.2vw,100px);font-weight:650;letter-spacing:-.075em;line-height:.98}
  h1 em{color:#087a52;font-style:normal}.hero__description{max-width:380px;margin:28px 0 34px;color:#5c6b72;font-size:clamp(15px,1.15vw,18px);line-height:1.75}
  .hero__cta{display:inline-flex;align-items:center;gap:28px;min-height:54px;padding:0 21px;border:1px solid #0a754e;border-radius:3px;background:#087a52;color:white;text-decoration:none;font-size:13px;font-weight:700;transition:background .25s ease,transform .25s ease,box-shadow .25s ease;box-shadow:0 9px 24px #087a5221}
  .hero__cta:hover{transform:translateY(-2px);background:#056b47;box-shadow:0 13px 28px #087a5233}.hero__cta svg{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}
  .hero__note{margin:52px 0 0;color:#83918d;font-size:9px;font-weight:700;letter-spacing:.18em}.hero__note b{padding:0 7px;color:#009040}
  .hero__visual{position:relative;align-self:center;height:min(88vh,900px);min-height:550px;margin:0 clamp(18px,4.2vw,68px) 22px 0;overflow:hidden;background:#f7f9f7}
  .hero__wash{position:absolute;inset:0;z-index:0;background:radial-gradient(ellipse at 50% 47%,#dbe8e76b,transparent 58%);pointer-events:none}
  .hero__fallback,.hero__canvas{position:absolute;inset:0;width:100%;height:100%;display:block;object-fit:cover}.hero__fallback{z-index:1;opacity:1;transition:opacity .2s ease}.hero__fallback.is-covered{opacity:0}
  .hero__canvas{z-index:2;opacity:0;transition:opacity .25s ease}.hero__canvas.is-visible{opacity:1}
  .hero__caption{position:absolute;z-index:3;right:4%;bottom:4%;display:flex;align-items:center;gap:10px;color:#6d7e79;font-size:9px;font-weight:700;letter-spacing:.17em;pointer-events:none}
  .hero__caption i{width:28px;height:1px;background:#009040}.hero__caption span{color:#9aa6a0;font-weight:500}
  .hero__progress{position:absolute;z-index:4;right:0;bottom:0;left:0;height:2px;background:#00184012}.hero__progress span{display:block;width:0;height:100%;background:#009040;transition:width .12s linear}
  .hero__bottom{position:absolute;z-index:3;right:4vw;bottom:26px;left:7.2vw;display:flex;justify-content:space-between;color:#91a09a;font-size:9px;font-weight:700;letter-spacing:.17em}.hero__bottom span:last-child{display:flex;align-items:center;gap:12px}.hero__bottom i{width:32px;height:1px;background:#009040}
  @media(max-width:900px){.hero{grid-template-columns:minmax(300px,42%) 1fr}.hero__copy{padding-left:5vw}h1{font-size:clamp(52px,7vw,72px)}.hero__visual{margin-right:2vw}}
  @media(max-width:680px){.hero{display:flex;flex-direction:column-reverse;height:auto;min-height:100svh;max-height:none;padding:0 0 58px}.hero__copy{flex:1;justify-content:flex-start;padding:8px 26px 22px}.hero__location{margin:0 0 17px;font-size:9px}h1{font-size:clamp(48px,13vw,68px);line-height:.98}.hero__description{max-width:330px;margin:18px 0 23px;font-size:14px;line-height:1.65}.hero__cta{min-height:50px}.hero__note{margin-top:26px;font-size:8px}.hero__visual{width:100%;height:min(54svh,470px);min-height:300px;margin:0}.hero__caption{right:6%;bottom:5%;font-size:7px;gap:7px}.hero__caption i{width:17px}.hero__bottom{right:26px;bottom:20px;left:26px;font-size:8px}.hero__bottom span:last-child{display:none}}
  @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.hero__fallback,.hero__canvas,.hero__cta{transition:none}}
</style>